# ignore build dir
build*/

# local Windows integration package (large, never part of the source tree)
/windows/

# ignore all dotfiles
.*

# except these
!.gitignore
!.qmake.conf
!.appveyor.yml
!.circleci/
!.travis/
!.github/

# ignore IDE project files
*.pro.user
*.kdev4
*.workspace

# ignore Qt generated files
*.qmlc
*.jsc
*.autosave
